
[init]
	defaultBranch = master
[pull]
	rebase = true
[alias]
	ignore = update-index --assume-unchanged
	unignore = update-index --no-assume-unchanged
	stash = stash -u
[merge]
	tool = vimdiff
[mergetool]
	keepBackup = false
[rerere]
	enabled = true
[stash]
	showincludeUntracked = true
	showpatch = true
	index = true
